# Esta carpeta contiene los scripts SQL del proyecto (DDL, datos de prueba,
# reglas de negocio y migraciones). No aporta nada por HTTP y puede exponer
# el modelo de datos interno, así que se bloquea el acceso directo igual que
# a backend/: sólo se usan localmente al importar en phpMyAdmin/mysql.
#
# Apache 2.4+ (XAMPP moderno / Debian con apache2):
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (compatibilidad):
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
