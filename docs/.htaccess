# Esta carpeta contiene documentación interna (diagramas UML/ER, RFE y
# entregas en Word/PDF). No forma parte del sitio público: se bloquea el
# acceso directo por HTTP para no filtrar esos documentos por la URL.
#
# Apache 2.4+ (XAMPP moderno / Debian con apache2):
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (compatibilidad):
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
